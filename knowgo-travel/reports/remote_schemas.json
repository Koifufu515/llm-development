      "schema": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "string",
            "description": "搜索关键词"
          },
          "location": {
            "type": "string",
            "description": "中心点经度纬度"
          },
          "radius": {
            "type": "string",
            "description": "搜索半径"
          },
          "strategy": {
            "type": "integer",
            "description": "召回策略，0=默认召回策略，1=优先召回扫街榜POI",
            "default": 0
          }
        },
        "required": [
          "keywords",
          "location"
        ]
      }
    },
    {
      "name": "maps_search_detail",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
