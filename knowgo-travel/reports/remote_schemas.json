            "type": "string",
            "description": "终点纬度"
          }
        },
        "required": [
          "lon",
          "lat"
        ]
      }
    },
    {
      "name": "maps_schema_take_taxi",
      "schema": {
        "type": "object",
        "properties": {
          "slon": {
            "type": "string",
            "description": "起点经度"
          },
          "slat": {
            "type": "string",
            "description": "起点纬度"
          },
          "sname": {
            "type": "string",
            "description": "起点名称"
          },
          "dlon": {
            "type": "string",
            "description": "终点经度"
          },
          "dlat": {
            "type": "string",
            "description": "终点纬度"
          },
