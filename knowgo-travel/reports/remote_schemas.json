          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "maps_text_search",
      "schema": {
        "type": "object",
        "properties": {
          "keywords": {
            "type": "string",
            "description": "查询关键字"
          },
          "city": {
            "type": "string",
            "description": "查询城市"
          },
          "citylimit": {
            "type": "boolean",
            "default": false,
            "description": "是否限制城市范围内搜索，默认不限制"
          }
        },
        "required": [
          "keywords"
        ]
      }
    },
    {
      "name": "maps_schema_navi",
      "schema": {
        "type": "object",
        "properties": {
          "lon": {
            "type": "string",
