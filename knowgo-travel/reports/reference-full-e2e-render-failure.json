    "itinerary_body": {
      "title": "苏州3日文化园林之旅",
      "days": [
        {
          "day": 1,
          "city": "苏州",
          "morning": [
            {
              "name": "抵达苏州北站并前往酒店",
              "kind": "transport",
              "description": "乘坐G986次高铁从上海出发，07:05发车，07:34抵达苏州北站；出站后建议打车或地铁前往蔚徕酒店（相城大道徐图港地铁站店），车程约25分钟，寄存行李后可稍作休整。酒店地址：元和街道春申湖中路235号。",
              "start_time": "07:34",
              "end_time": "08:30",
              "source_ids": []
            }
          ],
          "noon": [
            {
              "name": "平江路历史文化街区漫步与午餐",
              "kind": "attraction",
              "description": "平江路是苏州保存最完整的历史街区之一，沿河而建，白墙黛瓦、小桥流水，集中体现江南水乡风貌。可参观耦园、猫儿巷等节点，品尝苏式汤面、生煎包等本地小吃；街区多为老字号餐饮，推荐在评弹馆旁的临河面馆用午餐，体验边听评弹边用餐的慢生活。",
              "start_time": "11:30",
              "end_time": "13:30",
              "source_ids": [
                "6394c57360842788a39cc35a"
              ]
            }
          ],
          "afternoon": [
            {
              "name": "拙政园深度游览",
              "kind": "attraction",
              "description": "中国四大名园之一，始建于明代，以水为中心、疏朗自然。园内分东、中、西三部分，中园为精华所在，含远香堂、小沧浪、秫香馆等经典建筑；可参与每5–10分钟一班的免费中文导览（仅 Mandarin），内容涵盖‘中式婚礼’展示、树根雕艺及园内运河泛舟体验，全程约2小时。注意雨天备伞，部分廊道湿滑。",
              "start_time": "14:00",
              "end_time": "16:00",
              "source_ids": [
                "fe4998bfc580fbb5e6db7202"
              ]
            }
          ],
          "evening": [
            {
              "name": "观前街夜游与苏帮菜晚餐",
              "kind": "attraction",
              "description": "观前街是苏州传统商业中心，主街虽偏现代，但两侧支巷如太监弄、玄妙观周边藏有众多苏式老店与非遗手作铺；推荐在太监弄‘松鹤楼’或‘得月楼’（需提前电话确认营业）享用正宗苏帮菜，如松鼠鳜鱼、响油鳝糊、碧螺春熏豆干。饭后可步行至玄妙观广场感受市井烟火气。",
              "start_time": "17:30",
              "end_time": "19:30",
              "source_ids": [
                "6394c57360842788a39cc35a"
              ]
            }
          ],
          "tips": [
            "11月1日苏州预报小雨，气温14–25℃，西北风1–3级，请务必携带雨具；拙政园、平江路等户外景点建议优先安排在上午相对干燥时段，下午备好防滑鞋；所有园林及博物馆类景点开放时间与预约政策变动频繁，出行前3日内须通过‘君到苏州’微信公众号或‘苏州园林旅游’官方平台核实当日入园要求及余票情况。"
          ]
        },
        {
          "day": 2,
          "city": "苏州",
          "morning": [
            {
              "name": "网师园晨间静赏",
              "kind": "attraction",
              "description": "始建于南宋，1770年重建，被誉为苏州最小而最精美的古典园林。占地仅约8亩，却布局严谨、移步换景，殿春簃、月到风来亭、竹外一枝轩等皆为典范；清晨游客较少，光影柔和，适合静心品读建筑与植物配置的哲学意趣。园内偶有传统昆曲或评弹快闪演出（非每日固定），可留意公告栏信息。",
              "start_time": "08:30",
              "end_time": "10:30",
              "source_ids": [
                "fe4998bfc580fbb5e6db7202"
              ]
            }
          ],
          "noon": [
            {
              "name": "十全街苏式简餐与手作体验",
              "kind": "meal",
              "description": "十全街融合文艺与市井，沿街分布多家苏式茶馆与文创小店；推荐在‘桃源里’或‘吴门人家’用午餐，主打枫镇大肉面、酒酿圆子等时令点心；餐后可进入街角‘苏扇坊’（需现场咨询是否开放体验）了解宋锦团扇制作流程，部分时段提供简易手绘扇面活动（费用自理，约¥60/人）。",
              "start_time": "11:30",
              "end_time": "13:00",
              "source_ids": [
                "6394c57360842788a39cc35a"
              ]
            }
          ],
          "afternoon": [
            {
              "name": "苏州博物馆本馆参观",
              "kind": "attraction",
              "description": "由贝聿铭设计，新馆与忠王府古建群有机融合，展陈以吴地文明、明清书画、出土玉器为核心。常设展‘吴塔国宝’展出真珠舍利宝幢、五代越窑秘色瓷莲花碗等镇馆之宝；建筑本身即展品，片石假山、几何天窗、灰瓦白墙极具辨识度。馆内禁止闪光灯摄影，建议租用语音导览器（¥20）提升理解深度。",
              "start_time": "14:00",
              "end_time": "16:30",
              "source_ids": [
                "31f94a7794f664c16e07538a"
              ]
            }
          ],
          "evening": [
            {
              "name": "金鸡湖李公堤夜景与湖畔晚餐",
              "kind": "attraction",
              "description": "李公堤是金鸡湖上唯一人工堤坝，现为集艺术、餐饮、休闲于一体的滨水文化街区。傍晚华灯初上，可沿堤散步欣赏双塔倒影与现代灯光秀；推荐在‘湖畔四季’或‘松云楼’临湖包厢用餐，品尝太湖三白（白鱼、银鱼、白虾）时令做法，配一杯本地黄酒。注意末班地铁约22:30，预留返程交通时间。",
              "start_time": "17:30",
              "end_time": "19:30",
              "source_ids": [
                "6394c57360842788a39cc35a"
              ]
            }
          ],
          "tips": [
            "苏州博物馆实行实名制分时段预约，每日限流，须至少提前1天通过‘苏州博物馆’官方微信公众号预约，未预约无法入场；11月2日天气未预报，但秋季昼夜温差大，建议采用洋葱式穿衣法，随身携带薄外套；李公堤夜间人流密集，看管好随身物品，打车建议使用高德地图定位‘李公堤三期停车场’避免绕行。"
          ]
        },
        {
          "day": 3,
          "city": "苏州",
          "morning": [
            {
              "name": "虎丘景区核心游览",
              "kind": "attraction",
              "description": "素有‘吴中第一名胜’之称，拥有2500年历史，核心景观包括虎丘塔（中国第一斜塔）、剑池、千人石、真娘墓等。剑池传为吴王阖闾墓葬所在，深藏神秘；千人石传说曾染血千人，石面光滑如镜；登塔需体力，但顶层可俯瞰苏州古城肌理。建议按‘山门—断梁殿—真娘墓—千人石—剑池—虎丘塔’动线游览，全程约2.5小时。",
              "start_time": "08:30",
              "end_time": "11:00",
              "source_ids": [
                "31f94a7794f664c16e07538a"
              ]
            }
          ],
          "noon": [
            {
              "name": "山塘街水巷午餐与手信采购",
              "kind": "meal",
              "description": "山塘街‘七里山塘’全长3.8公里，白居易任苏州刺史时主持修筑，至今保留‘水陆并行、河街相邻’格局。推荐在通贵桥畔‘荣阳楼’品尝油汆团子、酱鸭、糖粥等地道小吃；饭后沿街选购碧螺春茶、苏绣小件、桃花坞木版年画等伴手礼，注意甄别正规商户（认准‘苏州老字号’标牌），避免景区高价劣质品。",
              "start_time": "11:30",
              "end_time": "13:00",
              "source_ids": [
                "164634a97b73dbe54f21f0c3"
              ]
            }
          ],
          "afternoon": [
            {
