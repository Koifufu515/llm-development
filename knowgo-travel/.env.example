# 复制为.env，真实凭证也可在外部服务配置.env单独填写，后者优先。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=knowgo
POSTGRES_USER=knowgo
POSTGRES_PASSWORD=change-this-local-password
MODEL_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 本账号Turbo返回429，本机用Plus；可换成自己可调用的轻量模型。
RAG_MODEL=qwen-plus
TAVILY_API_KEY=
AMAP_API_KEY=
TENCENT_MAP_KEY=
VARIFLIGHT_API_KEY=
AIGOHOTEL_MCP_API=
# 可选，留空使用自建stdio等价服务
BACKUP_WEATHER_MCP_URL=
IMAGE_SEARCH_MCP_URL=
# 可选兼容其他模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
